# Copy to .env and fill in your values

# Your OpenAI API key (used as fallback if client doesn't send Authorization header)
OPENAI_API_KEY=sk-...

# Upstream API base URL (default: https://api.openai.com)
# Change this to use a compatible API (e.g. Azure, local LLM)
# OPENAI_BASE_URL=https://api.openai.com

# Agents directory (default: ~/.ling-shu/agents)
# LING_SHU_AGENTS_DIR=/path/to/agents

# Server bind settings
# HOST=0.0.0.0
# PORT=8080
